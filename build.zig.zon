.{
    .name = .noctty,
    .version = "1.3.2-dev",
    .paths = .{""},
    // Fingerprint: high 32 bits are CRC-32 of the package name, low 32
    // bits are the original random id (kept across the winghostty->noctty
    // rename so package identity is preserved).
    .fingerprint = 0x80bfc21ea312488b,
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        // Zig libs

        .libxev = .{
            // nanasess/libxev, forked from the pinned mitchellh/libxev
            // 34fa50878 with a single commit (de97685) that skips stale
            // completion-queue entries whose result is null. Guards a
            // completion-reuse race in the IOCP backend hit by the renderer's
            // cursor blink timer (`loop.timer` re-inits a completion that is
            // still linked in the queue, clearing `result`, and the queue
            // drain then unwraps it). See nanasess/ghostinthewsl#4 / #5.
            .url = "https://github.com/nanasess/libxev/archive/de97685122ca5c31039cda87d321936b743105f0.tar.gz",
            .hash = "libxev-0.0.0-86vtc4YiEwCgHkvAjMYUFTgZEL1R_o-CnpWCNb40n1r4",
            .lazy = true,
        },
        .vaxis = .{
            // rockorager/libvaxis
            .url = "https://deps.files.ghostty.org/vaxis-7dbb9fd3122e4ffad262dd7c151d80d863b68558.tar.gz",
            .hash = "vaxis-0.5.1-BWNV_LosCQAGmCCNOLljCIw6j6-yt53tji6n6rwJ2BhS",
            .lazy = true,
        },
        .z2d = .{
            // vancluever/z2d
            .url = "https://deps.files.ghostty.org/z2d-0.10.0-j5P_Hu-6FgBsZNgwphIqh17jDnj8_yPtD8yzjO6PpHRQ.tar.gz",
            .hash = "z2d-0.10.0-j5P_Hu-6FgBsZNgwphIqh17jDnj8_yPtD8yzjO6PpHRQ",
            .lazy = true,
        },
        .uucode = .{
            // jacobsandlund/uucode
            .url = "https://deps.files.ghostty.org/uucode-0.2.0-ZZjBPqZVVABQepOqZHR7vV_NcaN-wats0IB6o-Exj6m9.tar.gz",
            .hash = "uucode-0.2.0-ZZjBPqZVVABQepOqZHR7vV_NcaN-wats0IB6o-Exj6m9",
